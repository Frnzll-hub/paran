<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>IQVERSE — IQ & Minat Bakat</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
 --bg:#050505;--card:#101010;--card2:#151515;
 --white:#fff;--gray:#888;--border:rgba(255,255,255,.12)
}
html{scroll-behavior:smooth}
body{
 background:var(--bg);color:white;
 font-family:Inter,Arial,sans-serif;
 overflow-x:hidden
}
button,a{font-family:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}

body:before{
 content:"";
 position:fixed;inset:0;z-index:-2;
 background-image:
 linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
 linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
 background-size:70px 70px
}
body:after{
 content:"";
 position:fixed;width:450px;height:450px;
 border-radius:50%;filter:blur(140px);
 background:#fff;opacity:.06;
 top:-200px;right:-150px;z-index:-1
}

/* NAVBAR */
.navbar{
 position:fixed;top:0;left:0;width:100%;height:76px;
 padding:0 6%;display:flex;align-items:center;
 justify-content:space-between;z-index:1000;
 transition:.3s
}
.navbar.scrolled{
 background:rgba(5,5,5,.85);
 backdrop-filter:blur(20px);
 border-bottom:1px solid var(--border)
}
.logo{font-size:21px;font-weight:900;letter-spacing:-1px}
.logo span{color:#777}
.navbar nav{display:flex;gap:35px}
.navbar nav a{font-size:12px;color:#888;transition:.3s}
.navbar nav a:hover{color:#fff}
.nav-btn,.primary{
 border:0;background:#fff;color:#000;
 padding:13px 21px;border-radius:50px;
 font-size:12px;font-weight:800;transition:.3s
}
.nav-btn:hover,.primary:hover{
 transform:translateY(-3px);
 box-shadow:0 15px 40px rgba(255,255,255,.12)
}
.menu{display:none;background:none;border:0;color:white;font-size:24px}

/* HERO */
.hero{
 min-height:100vh;padding:140px 8% 80px;
 display:grid;grid-template-columns:1.1fr .9fr;
 align-items:center;gap:50px
}
.badge{
 color:#777;font-size:10px;font-weight:700;
 letter-spacing:2px;margin-bottom:25px
}
.dot{
 display:inline-block;width:7px;height:7px;
 background:#fff;border-radius:50%;
 margin-right:8px;box-shadow:0 0 15px white
}
.hero h1{
 font-size:clamp(55px,8vw,110px);
 line-height:.88;letter-spacing:-7px
}
.outline{
 color:transparent;
 -webkit-text-stroke:1px #fff
}
.hero p{
 max-width:570px;color:#888;
 line-height:1.8;font-size:14px;margin:32px 0
}
.buttons{display:flex;gap:12px;flex-wrap:wrap}
.secondary{
 display:inline-flex;align-items:center;justify-content:center;
 padding:13px 21px;border-radius:50px;
 border:1px solid var(--border);
 background:#0d0d0d;color:white;
 font-size:12px;font-weight:700;transition:.3s
}
.secondary:hover{background:#fff;color:#000}
.stats{display:flex;gap:45px;margin-top:60px}
.stats strong{font-size:23px;display:block}
.stats span{
 color:#666;font-size:9px;
 text-transform:uppercase;letter-spacing:1px
}

/* HERO CARD */
.visual{
 height:500px;display:flex;
 align-items:center;justify-content:center;position:relative
}
.orbit{
 position:absolute;border:1px solid #222;
 border-radius:50%;animation:spin 18s linear infinite
}
.o1{width:420px;height:420px}
.o2{width:300px;height:300px;animation-direction:reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.brain{
 width:330px;height:390px;padding:35px;
 border:1px solid #292929;border-radius:30px;
 background:linear-gradient(145deg,#191919,#080808);
 box-shadow:0 40px 100px #000;
 position:relative;z-index:2;
 animation:float 5s ease-in-out infinite
}
@keyframes float{50%{transform:translateY(-15px)}}
.icon{
 width:65px;height:65px;border:1px solid #333;
 border-radius:18px;display:grid;place-items:center;
 font-size:28px;margin-bottom:60px
}
.brain small{color:#666;letter-spacing:2px}
.brain h3{font-size:20px;margin:14px 0 30px}
.bars{display:grid;gap:10px}
.bars i{height:5px;background:white;border-radius:10px;display:block}
.bars i:nth-child(2){width:70%;opacity:.6}
.bars i:nth-child(3){width:92%;opacity:.85}
.bars i:nth-child(4){width:60%;opacity:.35}
.brain-bottom{
 position:absolute;bottom:25px;left:35px;right:35px;
 border-top:1px solid #292929;padding-top:15px;
 display:flex;justify-content:space-between;
 color:#666;font-size:9px
}
.brain-bottom b{color:white}

/* SECTION */
.section{padding:130px 8%}
.label{color:#555;font-size:10px;letter-spacing:2px;font-weight:700}
.section h2{
 font-size:clamp(42px,6vw,75px);
 line-height:.95;letter-spacing:-4px;margin-top:20px
}

/* FEATURES */
.features{
 display:grid;grid-template-columns:repeat(4,1fr);
 gap:12px;margin-top:65px
}
.feature{
 min-height:290px;padding:30px;
 border:1px solid var(--border);
 background:#0c0c0c;border-radius:22px;
 transition:.4s;position:relative
}
.feature:hover{
 transform:translateY(-8px);background:#151515;
 border-color:#444
}
.num{position:absolute;right:25px;color:#444;font-size:10px}
.ficon{font-size:35px;margin:65px 0 30px}
.feature h3{font-size:16px;margin-bottom:12px}
.feature p{font-size:11px;color:#777;line-height:1.7}

/* ASSESSMENT */
.assessment{padding:70px 4%}
.app{
 max-width:1100px;margin:auto;min-height:600px;
 background:#090909;border:1px solid var(--border);
 border-radius:30px;overflow:hidden
}
.screen{padding:65px}
.start{min-height:600px;display:flex;flex-direction:column;justify-content:center}
.start h2{
 font-size:clamp(50px,7vw,85px);
 line-height:.9;letter-spacing:-5px
}
.start p{max-width:550px;color:#777;line-height:1.7;margin:30px 0}
.info{display:flex;gap:10px;margin-bottom:35px}
.info div{
 padding:17px 23px;border:1px solid var(--border);
 border-radius:15px
}
.info strong{display:block;font-size:18px}
.info span{font-size:9px;color:#666}
.hidden{display:none!important}

/* TEST */
.top{
 display:flex;justify-content:space-between;align-items:center
}
.top small{color:#666;font-size:9px;letter-spacing:2px}
.top h3{font-size:16px;margin-top:7px}
.timer,.interest-label{
 padding:12px 18px;border:1px solid var(--border);
 border-radius:50px;font-size:12px;font-weight:800
}
.progress{
 height:4px;background:#222;border-radius:10px;
 margin:30px 0 65px;overflow:hidden
}
.progress div{
 height:100%;width:0;background:white;transition:.4s
}
.question{max-width:800px;margin:auto}
.type{color:#666;font-size:9px;letter-spacing:2px}
.question h2{
 font-size:clamp(24px,4vw,37px);
 line-height:1.3;margin:18px 0 35px
}
.options{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.option{
 min-height:70px;padding:16px;
 display:flex;align-items:center;gap:15px;
 background:#101010;color:white;
 border:1px solid var(--border);
 border-radius:15px;text-align:left;transition:.25s
}
.option:hover{border-color:#666;transform:translateY(-2px)}
.option.selected{background:white;color:black;border-color:white}
.letter{
 width:32px;height:32px;display:grid;place-items:center;
 border:1px solid currentColor;border-radius:9px;
 font-weight:800;flex-shrink:0
}
.navigation{
 display:flex;justify-content:space-between;
 margin-top:55px
}

/* INTEREST */
.scale{display:grid;gap:10px}
.scale button{
 min-height:58px;padding:10px 18px;
 display:flex;align-items:center;gap:18px;
 border:1px solid var(--border);
 border-radius:14px;background:#101010;color:white;
 text-align:left;transition:.25s
}
.scale button:hover{background:white;color:black;transform:translateX(5px)}
.scale b{
 width:30px;height:30px;border:1px solid currentColor;
 border-radius:50%;display:grid;place-items:center
}
.scale span{font-size:12px}

/* RESULT */
.result-title{margin-bottom:45px}
.result-title span{font-size:9px;color:#666;letter-spacing:2px}
.result-title h2{
 font-size:clamp(50px,7vw,80px);
 line-height:.9;letter-spacing:-5px;margin-top:15px
}
.result-grid{
 display:grid;grid-template-columns:1fr 1fr;gap:12px
}
.result-card{
 background:#111;border:1px solid var(--border);
 border-radius:22px;padding:35px
}
.result-card>span{font-size:9px;color:#666;letter-spacing:2px}
.circle{
 width:190px;height:190px;margin:30px auto;position:relative
}
.circle svg{width:100%;height:100%;transform:rotate(-90deg)}
.circle circle{
 fill:none;stroke-width:7
}
.bg-circle{stroke:#252525}
.score-circle{
 stroke:white;stroke-linecap:round;
 stroke-dasharray:326.7;stroke-dashoffset:326.7;
 transition:1.5s
}
.circle-content{
 position:absolute;inset:0;
 display:flex;align-items:center;justify-content:center
}
.circle-content strong{font-size:48px}
.circle-content small{color:#666;margin-top:20px}
.result-card h3{text-align:center;font-size:20px}
.desc{
 text-align:center;color:#777;font-size:11px;
 line-height:1.6;margin-top:10px
}
.interest h3{
 font-size:38px;margin:28px 0 10px
}
.interest .desc{text-align:left;margin-bottom:30px}
.bar{margin-bottom:17px}
.bar-head{
 display:flex;justify-content:space-between;
 font-size:10px;margin-bottom:7px
}
.bar-head span:last-child{color:#666}
.bar-bg{height:5px;background:#252525;border-radius:10px;overflow:hidden}
.bar-fill{height:100%;background:white}
.actions{display:flex;gap:10px;margin-top:20px;flex-wrap:wrap}
.note{
 margin-top:30px;padding-top:20px;
 border-top:1px solid var(--border);
 color:#555;font-size:10px;line-height:1.7
}

/* ABOUT */
.about{
 display:grid;grid-template-columns:1fr 1fr;
 gap:100px;align-items:center
}
.about-text h2{margin-bottom:0}
.about-desc{color:#777;line-height:1.9;font-size:13px}

/* FOOTER */
footer{
 padding:50px 8%;border-top:1px solid var(--border);
 display:flex;justify-content:space-between;
 align-items:center;color:#555;font-size:10px
}
.footer-logo{font-weight:900;font-size:18px;color:white}
.footer-logo span{color:#777}

/* MOBILE */
@media(max-width:900px){
 .hero{grid-template-columns:1fr}
 .features{grid-template-columns:1fr 1fr}
 .result-grid{grid-template-columns:1fr}
 .about{grid-template-columns:1fr;gap:40px}
}
@media(max-width:650px){
 .navbar{padding:0 5%}
 .navbar nav{
  display:none;position:absolute;top:75px;left:5%;right:5%;
  padding:20px;background:#111;border:1px solid var(--border);
  border-radius:18px;flex-direction:column;gap:20px
 }
 .navbar nav.active{display:flex}
 .nav-btn{display:none}
 .menu{display:block}
 .hero{padding:125px 6% 70px}
 .hero h1{font-size:57px;letter-spacing:-4px}
 .visual{height:360px}
 .brain{width:280px}
 .o1{width:320px;height:320px}
 .o2{width:230px;height:230px}
 .stats{gap:20px}
 .section{padding:90px 6%}
 .features{grid-template-columns:1fr}
 .assessment{padding:35px 3%}
 .screen{padding:35px 22px}
 .start h2{font-size:54px}
 .info{display:grid;grid-template-columns:1fr 1fr}
 .info div:last-child{grid-column:span 2}
 .options{grid-template-columns:1fr}
 .navigation button{flex:1}
 footer{flex-direction:column;gap:20px;text-align:center}
}
</style>
</head>

