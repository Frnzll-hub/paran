const interestQuestions=[
 ["Teknologi","Saya senang mempelajari komputer, aplikasi, atau teknologi digital."],
 ["Sains","Saya tertarik memahami bagaimana alam dan berbagai fenomena bekerja."],
 ["Kreativitas","Saya senang membuat desain, gambar, video, atau karya kreatif."],
 ["Bisnis","Saya tertarik membuat ide usaha atau memikirkan strategi bisnis."],
 ["Sosial","Saya senang membantu orang lain dan bekerja dalam sebuah kelompok."],
 ["Bahasa","Saya menikmati membaca, menulis, berbicara, atau mempelajari bahasa."],
 ["Teknologi","Saya tertarik mencoba membuat website, aplikasi, atau program."],
 ["Sains","Saya menikmati eksperimen dan mencari tahu alasan terjadinya sesuatu."],
 ["Kreativitas","Saya sering mendapatkan ide baru untuk membuat sesuatu lebih menarik."],
 ["Bisnis","Saya suka mengatur uang, membuat perencanaan, atau mengembangkan proyek."],
 ["Sosial","Saya merasa nyaman berkomunikasi dan berdiskusi dengan orang lain."],
 ["Bahasa","Saya tertarik membuat cerita, artikel, presentasi, atau konten tulisan."],
 ["Teknologi","Saya suka memecahkan masalah menggunakan perangkat atau teknologi."],
 ["Sains","Saya tertarik pada matematika, penelitian, kesehatan, atau lingkungan."],
 ["Kreativitas","Saya senang mengeksplorasi gaya, visual, musik, atau ide baru."]
];


/* ==========================
   VARIABLES
========================== */

let iqIndex=0;
let interestIndex=0;
let answers=Array(20).fill(null);

let scores={
 Teknologi:0,
 Sains:0,
 Kreativitas:0,
 Bisnis:0,
 Sosial:0,
 Bahasa:0
};

let time=600;
let timer;


/* ==========================
   NAVIGATION
========================== */

function toggleMenu(){
 document.getElementById("nav").classList.toggle("active");
}

window.addEventListener("scroll",()=>{
 document.getElementById("navbar")
  .classList.toggle("scrolled",window.scrollY>50);
});


function startTest(){
 document.getElementById("assessment")
  .scrollIntoView({behavior:"smooth"});

 setTimeout(startIQ,500);
}


/* ==========================
   IQ TEST
========================== */

function startIQ(){

 clearInterval(timer);

 iqIndex=0;
 answers=Array(20).fill(null);
 time=600;

 document.getElementById("start").classList.add("hidden");
 document.getElementById("result").classList.add("hidden");
 document.getElementById("interest").classList.add("hidden");
 document.getElementById("iq").classList.remove("hidden");

 renderIQ();
 startTimer();
}


function renderIQ(){

 const q=iqQuestions[iqIndex];

 document.getElementById("counter").textContent=
 `Question ${String(iqIndex+1).padStart(2,"0")} / 20`;

 document.getElementById("type").textContent=q.type;
 document.getElementById("question").textContent=q.q;

 document.getElementById("iqProgress").style.width=
 ((iqIndex+1)/20*100)+"%";

 const box=document.getElementById("options");
 box.innerHTML="";

 q.o.forEach((text,i)=>{

  const btn=document.createElement("button");
  btn.className="option";

  if(answers[iqIndex]===i)
   btn.classList.add("selected");

  btn.innerHTML=`
   <span class="letter">${String.fromCharCode(65+i)}</span>
   <span>${text}</span>
  `;

  btn.onclick=()=>{
   answers[iqIndex]=i;
   document.querySelectorAll(".option")
    .forEach(x=>x.classList.remove("selected"));
   btn.classList.add("selected");
  };

  box.appendChild(btn);
 });

 document.getElementById("prev").disabled=iqIndex===0;

 document.getElementById("next").textContent=
 iqIndex===19?"Selesai IQ →":"Berikutnya →";
}


function next(){

 if(answers[iqIndex]===null){
  alert("Pilih jawaban terlebih dahulu.");
  return;
 }

 if(iqIndex<19){
  iqIndex++;
  renderIQ();
 }else{
  finishIQ();
 }
}


function previous(){

 if(iqIndex>0){
  iqIndex--;
  renderIQ();
 }
}


/* ==========================
   TIMER
========================== */

function startTimer(){

 timer=setInterval(()=>{

  time--;

  let m=Math.floor(time/60);
  let s=time%60;

  document.getElementById("timer").textContent=
   `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;

  if(time<=0){
   clearInterval(timer);
   finishIQ(true);
  }

 },1000);
}


function finishIQ(auto=false){

 if(!auto){

  let unanswered=
   answers.filter(x=>x===null).length;

  if(unanswered>0){

   if(!confirm(
    `Masih ada ${unanswered} soal belum dijawab. Lanjut?`
   )) return;

  }
 }

 clearInterval(timer);

 document.getElementById("iq").classList.add("hidden");
 document.getElementById("interest").classList.remove("hidden");

 interestIndex=0;

 scores={
  Teknologi:0,
  Sains:0,
  Kreativitas:0,
  Bisnis:0,
  Sosial:0,
  Bahasa:0
 };

 renderInterest();
}


/* ==========================
   INTEREST
========================== */

function renderInterest(){

 const item=interestQuestions[interestIndex];

 document.getElementById("interestCounter").textContent=
 `Question ${String(interestIndex+1).padStart(2,"0")} / 15`;

 document.getElementById("interestQuestion").textContent=
 item[1];

 document.getElementById("interestProgress").style.width=
 ((interestIndex+1)/15*100)+"%";
}


function answerInterest(value){

 const category=interestQuestions[interestIndex][0];

 scores[category]+=value;

 if(interestIndex<14){

  interestIndex++;
  renderInterest();

 }else{

  showResult();

 }
}


/* ==========================
   RESULT
========================== */

function showResult(){

 document.getElementById("interest").classList.add("hidden");
 document.getElementById("result").classList.remove("hidden");

 let score=0;

 iqQuestions.forEach((q,i)=>{
  if(answers[i]===q.a) score++;
 });

 let category="";
 let description="";

 if(score<=5){
  category="Perlu Latihan";
  description="Terus latih kemampuan logika dan penalaran melalui berbagai latihan.";
 }
 else if(score<=10){
  category="Cukup";
  description="Kamu memiliki dasar yang cukup dan masih bisa terus berkembang.";
 }
 else if(score<=15){
  category="Baik";
  description="Performa penalaranmu terlihat cukup baik pada assessment latihan ini.";
 }
 else if(score<=18){
  category="Sangat Baik";
  description="Kamu menunjukkan performa yang sangat baik pada assessment ini.";
 }
 else{
  category="Excellent";
  description="Kamu mendapatkan performa sangat tinggi pada assessment latihan ini.";
 }

 document.getElementById("score").textContent=score;
 document.getElementById("category").textContent=category;
 document.getElementById("description").textContent=description;

 setTimeout(()=>{

  document.getElementById("scoreCircle").style.strokeDashoffset=
   326.7-(score/20*326.7);

 },200);


 let sorted=Object.entries(scores)
  .sort((a,b)=>b[1]-a[1]);

 let top=sorted[0][0];

 document.getElementById("topInterest").textContent=top;

 const descriptions={
  Teknologi:"Cenderung tertarik pada komputer, pemrograman, teknologi digital, dan pemecahan masalah.",
  Sains:"Cenderung tertarik pada eksperimen, penelitian, matematika, alam, dan cara kerja sesuatu.",
  Kreativitas:"Cenderung menikmati desain, seni, visual, musik, dan menciptakan ide baru.",
  Bisnis:"Cenderung tertarik pada strategi, perencanaan, kewirausahaan, dan pengembangan usaha.",
  Sosial:"Cenderung menikmati komunikasi, kerja sama, membantu orang lain, dan aktivitas kelompok.",
  Bahasa:"Cenderung tertarik pada membaca, menulis, komunikasi, dan penggunaan bahasa."
 };

 document.getElementById("interestDescription").textContent=
 descriptions[top];

 const bars=document.getElementById("bars");
 bars.innerHTML="";

 sorted.forEach(([name,value])=>{

  let percent=Math.round(value/15*100);

  let div=document.createElement("div");
  div.className="bar";

  div.innerHTML=`
   <div class="bar-head">
    <span>${name}</span>
    <span>${percent}%</span>
   </div>

   <div class="bar-bg">
    <div class="bar-fill" style="width:${percent}%"></div>
   </div>
  `;

  bars.appendChild(div);
 });

 saveHistory(score,top);

 document.getElementById("assessment")
  .scrollIntoView({behavior:"smooth"});
}


/* ==========================
   HISTORY
========================== */

function saveHistory(score,interest){

 let history=
  JSON.parse(localStorage.getItem("iqverseHistory")||"[]");

 history.unshift({
  date:new Date().toLocaleString("id-ID"),
  score,
  interest
 });

 localStorage.setItem(
  "iqverseHistory",
  JSON.stringify(history.slice(0,10))
 );
}


/* ==========================
   RESTART
========================== */

function restart(){

 clearInterval(timer);

 document.getElementById("result").classList.add("hidden");
 document.getElementById("interest").classList.add("hidden");
 document.getElementById("iq").classList.add("hidden");
 document.getElementById("start").classList.remove("hidden");

 document.getElementById("scoreCircle").style.strokeDashoffset=326.7;

 document.getElementById("assessment")
  .scrollIntoView({behavior:"smooth"});
}


/* ==========================
   SHARE
========================== */

function share(){

 let score=0;

 iqQuestions.forEach((q,i)=>{
  if(answers[i]===q.a)score++;
 });

 let top=Object.entries(scores)
  .sort((a,b)=>b[1]-a[1])[0][0];

 const text=
 `Hasil IQVERSE\nSkor latihan: ${score}/20\nMinat utama: ${top}`;

 if(navigator.share){

  navigator.share({
   title:"Hasil IQVERSE",
   text:text
  });

 }else{

  navigator.clipboard.writeText(text);
  alert("Hasil berhasil disalin!");

 }
}
</script>

